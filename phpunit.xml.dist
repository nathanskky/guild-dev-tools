<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="defects"
         resolveDependencies="true"
         requireCoverageMetadata="true"
         beStrictAboutCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnPhpunitDeprecations="true"
         failOnPhpunitDeprecation="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnEmptyTestSuite="true">
    <testsuites>
        <testsuite name="guild-dev-tools">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <php>
        <!-- The test kit visits the fixture application with persona sign-in, which refuses real credentials. -->
        <env name="PERSONA_SIGN_IN_ENABLED" value="true" force="true"/>
        <env name="OIDC_CLIENT_SECRET" value="" force="true"/>
        <env name="GROUPER_PASSWORD" value="" force="true"/>
    </php>

    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
