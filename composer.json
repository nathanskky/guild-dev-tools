{
    "name": "guild/dev-tools",
    "description": "Persona sign-in for local development and tests of Guild applications. Install with require-dev only.",
    "type": "guild-extension",
    "authors": [
        {
            "name": "Nathan Skky Rodriguez",
            "email": "nsrodrig@iu.edu"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-rivet.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-access.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-grouper.git"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "guild/framework": "^2.1",
        "guild/grouper": "^0.1.3",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.2",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "Guild\\DevTools\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guild\\DevTools\\Test\\": "tests"
        }
    },
    "extra": {
        "guild": {
            "extension": "Guild\\DevTools\\PersonaSignInExtension"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@test",
            "@analyse",
            "@format:check"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite (fails if no tests run).",
        "analyse": "Run PHPStan at level 10 over src/.",
        "format": "Auto-fix code style with Pint (PSR-12).",
        "format:check": "Check code style with Pint (PSR-12) without modifying files.",
        "check": "Run tests, static analysis, then style check. Stops at the first failure."
    }
}
